# Copy this file to .env (same folder) and fill in your keys. .env is git-ignored.
SHETU_ENVIRONMENT=local
# SQLite by default. For Postgres: postgresql://user:password@host:5432/shetu
# SHETU_DATABASE_URL=postgresql://shetu:shetu@localhost:5432/shetu
SHETU_CORS_ORIGINS=["http://localhost:3000"]

# Which model Shetu uses: gemini | groq | local | anthropic | replay
#   replay = recorded answers, no network (tests and offline demos)
#   local  = a model running on this machine through Ollama; no data leaves it
SHETU_AI_PROVIDER=gemini

# Paste keys after the = sign, with no quotes or spaces
SHETU_GEMINI_API_KEY=
SHETU_GEMINI_MODEL=gemini-2.5-flash
SHETU_GROQ_API_KEY=
SHETU_GROQ_MODEL=llama-3.3-70b-versatile
SHETU_ANTHROPIC_API_KEY=
SHETU_ANTHROPIC_MODEL=claude-sonnet-5-5

# Local model (Ollama exposes an OpenAI-compatible API on port 11434)
SHETU_LOCAL_BASE_URL=http://localhost:11434/v1
SHETU_LOCAL_MODEL=qwen3:4b

# Save every live reply under fixtures/replay so replay mode can reuse it
SHETU_AI_RECORD=true
